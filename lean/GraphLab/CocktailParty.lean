import GraphLab.Decide

namespace GraphLab

/-- CP(t) adjacency matrix: complete graph K_{2t} minus the perfect
matching {(2i, 2i+1) : i < t}. Vertex 2i is paired with vertex 2i+1. -/
def CPA (t : Nat) : Matrix := fun i j =>
  decide (i < 2 * t) && decide (j < 2 * t) && (i != j) && !(i / 2 == j / 2 && i % 2 != j % 2)

theorem CPA_irrefl (t : Nat) : ∀ i : Nat, CPA t i i = false := by
  intro i
  unfold CPA
  simp

theorem CPA_sym (t : Nat) : ∀ i j : Nat, CPA t i j = CPA t j i := by
  intro i j
  unfold CPA
  have h1 : (i != j) = (j != i) := by
    by_cases h : i = j
    · rw [h]
    · rw [bne_iff_ne.mpr h, bne_iff_ne.mpr (Ne.symm h)]
  have h2 : (i / 2 == j / 2) = (j / 2 == i / 2) := by
    by_cases h : i / 2 = j / 2
    · rw [h]
    · have hf1 : (i / 2 == j / 2) = false := by
        rw [Bool.eq_false_iff]; intro eq; exact h (beq_iff_eq.mp eq)
      have hf2 : (j / 2 == i / 2) = false := by
        rw [Bool.eq_false_iff]; intro eq; exact h (beq_iff_eq.mp eq).symm
      rw [hf1, hf2]
  have h3 : (i % 2 != j % 2) = (j % 2 != i % 2) := by
    by_cases h : i % 2 = j % 2
    · rw [h]
    · rw [bne_iff_ne.mpr h, bne_iff_ne.mpr (Ne.symm h)]
  have h4 : (decide (i < 2 * t) && decide (j < 2 * t)) = (decide (j < 2 * t) && decide (i < 2 * t)) := by
    rw [Bool.and_comm]
  rw [h1, h2, h3, h4]

/-! ### Constructive Branch-Set Certificates for CP(t) Minors

For any t, h(CP(t)) ≥ t + ⌊t/2⌋.
Verified by Lean's kernel via `decide` using the exact constructive branch models
generated by GraphLab's constructive model algorithm:
- CP(1): K_1 minor on 2 vertices
- CP(2): K_3 minor on 4 vertices
- CP(3): K_4 minor on 6 vertices
- CP(4): K_6 minor on 8 vertices
- CP(5): K_7 minor on 10 vertices
-/

theorem CP1_model : validBranchModel 2 1 (CPA 1) 1 = true := by decide
theorem CP1_h1 : hasKMinor 2 1 (CPA 1) = true :=
  hasKMinor_of_model 2 1 (CPA 1) 1 (by decide) CP1_model (by decide)

theorem CP2_model : validBranchModel 4 3 (CPA 2) 217 = true := by decide
theorem CP2_h3 : hasKMinor 4 3 (CPA 2) = true :=
  hasKMinor_of_model 4 3 (CPA 2) 217 (by decide) CP2_model (by decide)

theorem CP3_model : validBranchModel 6 4 (CPA 3) 2911 = true := by decide
theorem CP3_h4 : hasKMinor 6 4 (CPA 3) = true :=
  hasKMinor_of_model 6 4 (CPA 3) 2911 (by decide) CP3_model (by decide)

theorem CP4_model : validBranchModel 8 6 (CPA 4) 5506586 = true := by decide
theorem CP4_h6 : hasKMinor 8 6 (CPA 4) = true :=
  hasKMinor_of_model 8 6 (CPA 4) 5506586 (by decide) CP4_model (by decide)

theorem CP5_model : validBranchModel 10 7 (CPA 5) 131253841 = true := by decide
theorem CP5_h7 : hasKMinor 10 7 (CPA 5) = true :=
  hasKMinor_of_model 10 7 (CPA 5) 131253841 (by decide) CP5_model (by decide)

end GraphLab